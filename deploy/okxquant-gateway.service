[Unit]
Description=OKXQuant Gateway Worker
After=network.target

[Service]
Type=simple
User=okxquant
Group=okxquant
Environment=HOME=/home/okxquant
Environment=PATH=/opt/OKXQuant/.venv/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/opt/OKXQuant
EnvironmentFile=/opt/OKXQuant/.env
ExecStart=/opt/OKXQuant/.venv/bin/python -m okxquant_gateway.worker
Restart=always
RestartSec=5
NoNewPrivileges=true
UMask=0077
PrivateTmp=true

[Install]
WantedBy=multi-user.target
