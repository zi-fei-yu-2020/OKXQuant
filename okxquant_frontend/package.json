{
  "name": "okxquant_frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "assets:prepare": "node scripts/prepare-assets.mjs",
    "predev": "npm run assets:prepare",
    "dev": "vite",
    "prebuild": "npm run assets:prepare",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "klinecharts": "10.0.3",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11"
  }
}
