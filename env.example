# ==============================================================================
# OKXQuant QUANTUM TRADER - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your own credentials.
# ==============================================================================

# LLM Reasoning Gateway Configuration (OpenAI-compatible)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-3.7-flash-high
LLM_REASONING_EFFORT=high

# OKX dual-environment configuration. LIVE and DEMO API Keys must be created separately.
# The official OKX CLI is also required: npm install -g @okx_ai/okx-trade-cli@^1.4.4
# API Key mode is recommended for unattended servers. Alternatively, CLI OAuth must be
# completed by the SAME Linux user/HOME that runs backend and gateway; never copy ~/.okx.
# All strategy, ledger, dashboard and manual-close private requests share OKXQUANT_OKX_ENV.
# Demo requests automatically carry x-simulated-trading: 1. Safe default is demo.
OKXQUANT_OKX_ENV=demo
OKX_LIVE_API_KEY=
OKX_LIVE_SECRET_KEY=
OKX_LIVE_PASSPHRASE=
OKX_DEMO_API_KEY=
OKX_DEMO_SECRET_KEY=
OKX_DEMO_PASSPHRASE=
# Legacy migration keys (optional; the admin plane stores new secrets encrypted).
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_IS_SIMULATED=1

# Web Dashboard Port & Host
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080

# Administrator protection for /admin. Generate a random setup token before first launch.
# After first login, set a permanent admin token in the admin page.
OKXQUANT_SETUP_TOKEN=replace_with_a_long_random_setup_token
OKXQUANT_ADMIN_TOKEN=
OKXQUANT_MANUAL_CLOSE_ENABLED=0

# Notification fan-out. Each channel is independently enabled and can be tested from /admin.
OKXQUANT_NOTIFY_WEBHOOK_ENABLED=0
OKXQUANT_NOTIFICATION_WEBHOOK=https://your-notification-endpoint.example/okxquant
OKXQUANT_NOTIFY_WECHAT_ENABLED=0
OKXQUANT_WECHAT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your-key
OKXQUANT_NOTIFY_TELEGRAM_ENABLED=0
OKXQUANT_TELEGRAM_BOT_TOKEN=
OKXQUANT_TELEGRAM_CHAT_ID=
# Native QQ official application Bot. OKXQuant obtains its own token and calls QQ Bot API directly.
OKXQUANT_NOTIFY_QQ_ENABLED=0
OKXQUANT_QQ_APP_ID=
OKXQUANT_QQ_CLIENT_SECRET=
OKXQUANT_QQ_OPENID=

# Backup targets are configured from /admin. Jobs keep only credential_ref;
# S3/OSS/WebDAV/Baidu OAuth secrets are encrypted in data/okxquant_backup_secrets.enc.
# Supported: local, Baidu official OAuth or ByPy, S3-compatible, Aliyun OSS,
# WebDAV/OpenList, Aliyun Drive bridge, and experimental Quark bridge.
OKXQUANT_BACKUP_ENCRYPTION_KEY=

# ==============================================================================
# Docker Compose Deployment Options (ignored safely in native mode)
# ==============================================================================
# OKXQUANT_HTTP_PORT=8080
# OKXQUANT_IMAGE=OKXQuant:local
# OKXQUANT_NODE_IMAGE=node:22-bookworm-slim
# OKXQUANT_PYTHON_IMAGE=python:3.12-slim-bookworm
# OKXQUANT_OKX_CLI_SPEC=@okx_ai/okx-trade-cli@^1.4.4

# Independent deterministic protection (Linux/WSL), no model calls.
# Set to 0 only to disable the additional guard; main fail-closed protection remains.
OKXQUANT_POSITION_GUARD_ENABLED=1

# Local validation controls (not an exchange-wide kill switch).
# 0 serves the UI without launching the Gateway worker; restart backend to apply.
OKXQUANT_GATEWAY_AUTOSTART=1
# 0 pauses FUTURE scheduled trader cycles. Existing orders and running cycles remain.
# Independent protection, ledger and other maintenance jobs continue; reloaded each tick.
OKXQUANT_AUTOTRADE_ENABLED=1
